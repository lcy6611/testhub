# Docker 开发环境配置示例
# 使用方式：
# 1) 复制为 docker/.env.docker
# 2) 按需修改

# Django
SECRET_KEY=django-insecure-change-me
DEBUG=True

# MySQL（与本地共用一库时：docker-compose.dev.yml 已用 DB_HOST=host.docker.internal 连宿主机）
# 请与本地 .env / 本地运行时的 DB 配置保持一致，否则容器和本地会连到不同库
DB_NAME=testhub
DB_USER=root
DB_PASSWORD=141008
DB_HOST=localhost

# Redis
REDIS_PASSWORD=123456

# 本机端口映射（可选）
BACKEND_PORT_LOCAL=8000
FRONTEND_PORT_LOCAL=5173
DB_PORT_LOCAL=3306
REDIS_PORT_LOCAL=6379

